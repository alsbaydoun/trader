TRADING_MODE=paper
BROKER_ADAPTER=paper
LIVE_TRADING_ENABLED=false
LIVE_TRADING_ACKNOWLEDGEMENT=
LIVE_TRADING_REQUIRED_ACK=I understand live trading can lose money

DEFAULT_SYMBOLS=XAUUSD,XAGUSD,BTCUSD,US100.std,US30.std,WTI.m,BRENT.m
DEFAULT_TIMEFRAME=1m
MAX_RISK_PER_TRADE_PCT=0.5
MAX_DAILY_LOSS_PCT=2
MAX_OPEN_POSITIONS=3
MAX_SYMBOL_EXPOSURE_PCT=5
MARKET_SCAN_MAX_SYMBOLS=500
MARKET_SCAN_CACHE_SECONDS=300

PAPER_AUTO_ENABLED=true
PAPER_STATE_FILE=../../data/paper-regime-trading.json
PAPER_STARTING_BALANCE=10000
PAPER_RISK_PER_TRADE_PCT=0.05
PAPER_MAX_OPEN_POSITIONS=3
PAPER_MIN_OPPORTUNITY_SCORE=62
PAPER_COMMISSION_BPS=1
PAPER_SLIPPAGE_BPS=1
PAPER_CYCLE_INTERVAL_SECONDS=60
PAPER_MAX_POSITION_MINUTES=120
PAPER_ADAPTIVE_LEARNING_ENABLED=true
PAPER_LEARNING_MIN_SAMPLES=8

JDUB_PAPER_AUTO_ENABLED=true
JDUB_PAPER_STATE_FILE=../../data/jdub-traders-paper.json
JDUB_PAPER_SESSION_STATE_FILE=../../data/jdub-traders-sessions.json
JDUB_PAPER_STARTING_BALANCE=10000
JDUB_PAPER_RISK_PER_TRADE_PCT=0.05
JDUB_PAPER_MAX_OPEN_POSITIONS=3
JDUB_PAPER_MIN_OPPORTUNITY_SCORE=65
JDUB_PAPER_CYCLE_INTERVAL_SECONDS=60
JDUB_PAPER_MAX_POSITION_MINUTES=90

EXTREME_PAPER_AUTO_ENABLED=true
EXTREME_PAPER_STATE_FILE=../../data/extreme-pullback-trading.json
EXTREME_PAPER_STARTING_BALANCE=10000
EXTREME_PAPER_RISK_PER_TRADE_PCT=0.05
EXTREME_PAPER_MAX_OPEN_POSITIONS=3
EXTREME_PAPER_MIN_OPPORTUNITY_SCORE=70
EXTREME_PAPER_CONFIRMED_ONLY=true
EXTREME_PAPER_MAX_POSITION_MINUTES=60

EXTREME_SCAN_ENABLED=true
EXTREME_SCAN_CACHE_SECONDS=10
EXTREME_SCAN_INTERVAL_SECONDS=15
EXTREME_ALERT_COOLDOWN_SECONDS=300

DATABASE_URL=postgresql+psycopg://trader:trader@postgres:5432/trader
REDIS_URL=redis://redis:6379/0
LOG_LEVEL=INFO

NEWS_PROVIDER=auto
NEWS_API_KEY=
MT5_CALENDAR_FILE=
OPENAI_API_KEY=

MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_ACCOUNT_TYPE=
MT5_TERMINAL_PATH=
MT5_ACCOUNTS_FILE=../../data/mt5-accounts.json
MT5_READ_ONLY_ENABLED=true
MT5_TIMEOUT_MS=10000
